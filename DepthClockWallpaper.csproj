		<PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.1" />
		<PackageReference Include="SkiaSharp.Views.WindowsForms" Version="3.119.1" />
		<PackageReference Include="System.Drawing.Common" Version="8.0.1" />
	</ItemGroup>

	
	<ItemGroup>
		<EmbeddedResource Include="depth_anything_v2_small.onnx" />
		<EmbeddedResource Include="depth_anything_v2_small.onnx.data" />
		<EmbeddedResource Include="icon.ico" />
	</ItemGroup>
	
